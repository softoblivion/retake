<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console test runner for the core: no test framework, plain asserts, exit code 0 on success. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Retake.Tests</RootNamespace>
    <AssemblyName>Retake.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Retake.Core\Retake.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reference files written by the 1.x core; copied beside the test executable. -->
    <None Include="fixtures\**\*" Exclude="fixtures\generate.py;fixtures\README.md" CopyToOutputDirectory="PreserveNewest" LinkBase="" />
  </ItemGroup>
</Project>
