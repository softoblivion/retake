<Project Sdk="Microsoft.NET.Sdk">
  <!-- The application: window, design layer, player, views. One exe, no packages at runtime. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>Retake</RootNamespace>
    <AssemblyName>Retake</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Retake.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Retake.Core\Retake.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Static per-weight font files, read through pack://application:,,,/fonts/#Sora. -->
    <Resource Include="fonts\*.ttf" />
    <!-- The two themes; the single source of every colour of the window. -->
    <EmbeddedResource Include="Design\themes.json" LogicalName="Retake.Design.themes.json" />
  </ItemGroup>
</Project>
